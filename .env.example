# ---- Model backend: mock | hosted | local -----------------------------------
MODEL_BACKEND=hosted

# hosted: Anthropic (default) or any OpenAI-compatible API
LLM_PROVIDER=anthropic
LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=            # e.g. https://api.openai.com/v1 for provider=openai

# local: Hugging Face model (pip install -r requirements-local.txt)
# LOCAL_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
# HF_TOKEN=

# ---- Hosting -----------------------------------------------------------------
# One API key per user, comma separated. Each key gets its own private workspace.
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Local single-user development only (no auth, one shared "dev" workspace):
# AUTH_DISABLED=true
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
# WORKSPACES_DIR=./workspaces
